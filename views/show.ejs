<% layout("/layout/boilerplate") %>
    <body>
        <div class="row">
            <h2 class="mt-3">Listings details !</h2>
            <div class="col">
            <img src="<%= allinfo.image.url %>">
            </div>
            <div class="col">
                <div class="card shadow-lg border-0 rounded-3 position-relative" style="width: 25rem ;height:30rem;">

                <div class="position-absolute top-0 end-0 p-2 d-flex gap-2">
                <button class="btn-light rounded-circle shadow-sm">
                <i class="bi bi-heart"></i>
                </button>
                <button class="btn-light rounded-circle shadow-sm">
                <i class="bi bi-share"></i>
                </button>
                </div>
                <div class="card-body">
                <h2 class="card-title mt-5 show-title">
                <%=allinfo.title %>
                </h2>
                <h4 class="text-muted">
                <%=allinfo.location%>,
                </h4>
                <h4 class="text-muted">
                <%=allinfo.country%>
                </h4>
                <h6 class="card-text mt-3">
                <%=allinfo.description%>
                </h4>
                <h6 class="mt-3">
                Price : <%=allinfo.price%>/night
                </h4>
                <form>
                <a href="/listings/<%=allinfo._id%>/edit" class="btn mt-3">Edit</a>
                </form>
                <form method="post" action="/listings/<%=allinfo._id%>?_method=Delete">
                <button class="btn btn-dark mt-3">Delete</button>
                </form>

                </div>
                </div>
            </div>
        </div>

        </div>
    </body>

    </html>