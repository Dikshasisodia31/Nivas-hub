<% layout("/layout/boilerplate") %>

  <div class="row mt-5 border-0 rounded-3 position-relative">
    <h3 class="text-center mt-5">Login</h3>
    <div class="col-6 offset-3">
      <form action="/login" method="post" class="needs-validation">
        <div class="mb-3 mt-5">
          <div class="title-cont input-box">
            <label for="username" name="username">Username</label><br>
            <input name="username" class="form-control m-2" type="text" required>
          </div>
          <div class="title-cont input-box">
            <label for="password" name="password">Password</label><br>
            <input name="password" class="form-control m-2" type="password" required>
          </div>
          <button class="btn btn-success mt-3 mb-3">Login</button>
        </div>
        <h4 class="text-center mt-5">New User? <a href="/signup">Signup</a></h4>
      </form>
    </div>
  </div>